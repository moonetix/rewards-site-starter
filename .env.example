# Copy to .env and fill in. Never commit .env. Real environment variables take precedence.

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key
# Credit dashboard test postbacks (transaction ID starts with test_). Keep false in production.
MOONETIX_CREDIT_TEST_POSTBACKS=false

SITE_NAME=Rewards Starter
CURRENCY_NAME=Coins
# Comma-separated emails that may open /admin.php
ADMIN_EMAILS=you@example.com

REDEEM_MIN_COINS=1000
REDEEM_HOLD_DAYS=3
REDEEM_METHODS=PayPal,Amazon gift card

REGISTER_LIMIT_PER_HOUR=3
LOGIN_LIMIT_PER_15_MIN=10

# Outside the web root. The directory is created on first use.
DATABASE_PATH=./data/rewards.sqlite
# auto, true or false. auto detects https, also behind a proxy that sets X-Forwarded-Proto.
SESSION_SECURE=auto
# Behind Cloudflare: CF-Connecting-IP. Leave empty when PHP sees the visitor's address directly.
CLIENT_IP_HEADER=
